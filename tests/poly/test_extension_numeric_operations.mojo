"""Independent numerical toolkit identities and numerical-domain coverage."""
from apn_mojo import contains
from std.testing import assert_equal, assert_true
from apn_mojo import Float, Rational, FloatFormat, ArithmeticContext, ComplexContext, Complex, Ball, BallContext
from poly import dense, sparse, to_sparse, to_dense


def main() raises:
    var ctx = ArithmeticContext(format=FloatFormat(precision=96))
    var p = dense.asarray([1, 2, 1], context=ctx)
    var q = dense.asarray([1, 1], context=ctx)
    var division = dense.divmod(p, q, context=ctx)
    assert_equal(division[0][0].to_rational_exact(), Rational(1))
    assert_equal(division[0][1].to_rational_exact(), Rational(1))
    assert_equal(len(division[1]), 0)
    var checked = dense.divide_checked(p, q, context=ctx)
    assert_true(dense.check_division(checked))
    assert_equal(checked.quotient()[1].to_rational_exact(), Rational(1))
    assert_equal(len(checked.remainder()), 0)
    var jet = dense.jet_evaluate(p, 1, 5, context=ctx)
    assert_equal(len(jet), 5)
    var expected = [4, 4, 1, 0, 0]
    for i in range(len(jet)):
        assert_equal(jet[i].to_rational_exact(), Rational(expected[i]))
    assert_equal(len(jet.to_list()), 5)
    var samples = dense.evaluate_many(p, [-1, 0, 1, -1], context=ctx)
    assert_equal(len(samples), 4)
    assert_equal(samples[0].to_rational_exact(), Rational(0))
    assert_equal(samples[2].to_rational_exact(), Rational(4))
    assert_equal(samples[3].to_rational_exact(), Rational(0))
    var interpolated = dense.interpolate([-1, 0, 1], [0, 1, 4], context=ctx)
    assert_equal(interpolated.to_list(), p.to_list())
    var jets: List[List[Int]] = [[1, 2], [4]]
    var hermite = dense.hermite_interpolate([0, 1], jets, context=ctx)
    assert_equal(hermite.to_list(), p.to_list())
    var scaled = dense.affine_transform(p, 2, 1, context=ctx)
    assert_equal(scaled[0].to_rational_exact(), Rational(4))
    assert_equal(scaled[1].to_rational_exact(), Rational(8))
    assert_equal(scaled[2].to_rational_exact(), Rational(4))
    assert_equal(dense.taylor_shift(p, 1, context=ctx)[1].to_rational_exact(), Rational(4))
    assert_equal(dense.definite_integral(q, 0, 2, context=ctx).to_rational_exact(), Rational(4))
    var sp = to_sparse(p, context=ctx)
    assert_equal(to_dense(sparse.divmod(sp, to_sparse(q, context=ctx), context=ctx)[0], context=ctx).to_list(), q.to_list())
    assert_equal(to_dense(sparse.compose(sp, to_sparse(q, context=ctx), context=ctx), context=ctx)[0].to_rational_exact(), Rational(4))
    assert_equal(sparse.taylor_shift(sp, 1, context=ctx)[0][1].to_rational_exact(), Rational(4))
    assert_equal(sparse.affine_transform(sp, 2, 1, context=ctx)[1][1].to_rational_exact(), Rational(8))
    assert_equal(sparse.jet_evaluate(sp, 1, 5, context=ctx)[3].to_rational_exact(), Rational(0))
    assert_equal(sparse.definite_integral(to_sparse(q, context=ctx), 0, 2, context=ctx)[0][1].to_rational_exact(), Rational(4))
    assert_equal(sparse.evaluate_many(sp, [-1, 0, 1], context=ctx)[2].to_rational_exact(), Rational(4))
    var multivariate = sparse.asarray([((2, 0), 1), ((0, 1), 2)], context=ctx)
    var replacement = sparse.asarray([((0, 1), 1)], context=ctx)
    var substituted = sparse.substitute(multivariate, [(0, replacement.copy())], context=ctx)
    assert_equal(sparse.evaluate(substituted, (5, 3), context=ctx).to_rational_exact(), Rational(15))
    assert_equal(sparse.evaluate_many(multivariate, [(2, 1), (3, 2)], context=ctx)[1].to_rational_exact(), Rational(13))
    var shifted_surface = sparse.affine_transform(multivariate, 2, 1, context=ctx, axis=0)
    assert_equal(sparse.evaluate(shifted_surface, (2, 3), context=ctx).to_rational_exact(), Rational(31))
    var integrated_surface = sparse.definite_integral(multivariate, 0, 3, context=ctx, axis=0)
    assert_equal(sparse.evaluate(integrated_surface, (7, 2), context=ctx).to_rational_exact(), Rational(21))
    var bc = BallContext(precision=96)
    var enclosed = dense.interpolate([0, 1], [Rational(1, 3), Rational(2, 3)], context=bc)
    assert_true(contains(dense.evaluate(enclosed, 1, context=bc), Rational(2, 3)))
    var ball_division = dense.divide_checked(dense.asarray([1, 2, 1], context=bc), dense.asarray([1, 1], context=bc), context=bc)
    assert_true(dense.check_division(ball_division))
    assert_true(ball_division.evidence().uniform)
    var cc = ComplexContext(ctx)
    var complex = dense.interpolate([0, 1], [Complex(0, 1), Complex(1, 1)], context=cc)
    assert_equal(dense.evaluate(complex, 2, context=cc).imag().to_rational_exact(), Rational(1))
    assert_equal(p[0].to_rational_exact(), Rational(1))
    print("array extension numeric_operations checks passed")
