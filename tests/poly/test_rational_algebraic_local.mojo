"""Partial fractions, conjugate poles, and Laurent coefficients over exact fields."""
from poly import rational, dense, algebraic, coefficients
from std.testing import assert_true, assert_equal, assert_false


def main() raises:
    var a = dense.root_between([-2, 0, 1], 1, 2)
    var linear = dense.asarray(coefficients((algebraic.negative(a), 1)))
    var f = rational.asarray([1], dense.multiply(dense.power(linear, 2), [1, 1]))
    var parts = rational.partial_fractions(f)
    assert_true(rational.check(parts))
    assert_equal(len(parts.terms), 3)
    var rebuilt = rational.asarray(parts.polynomial)
    for term in parts.terms:
        rebuilt = rational.add(rebuilt, rational.asarray(term[0], dense.power(term[1], term[2])))
    assert_true(rational.evaluate(rebuilt, 0) == rational.evaluate(f, 0))
    var bad = parts.copy()
    bad.polynomial = dense.asarray([a.copy()])
    assert_false(rational.check(bad))
    var poles = rational.poles(f)
    assert_equal(len(poles[1]), 2)
    var at_pole = rational.laurent(f, a, terms=4)
    assert_equal(at_pole.valuation, -2)
    assert_true(rational.check(at_pole))
    var inverse = algebraic.reciprocal(algebraic.add(a, 1))
    assert_true(at_pole.coefficients[0] == inverse)
    assert_true(at_pole.coefficients[1] == algebraic.negative(algebraic.multiply(inverse, inverse)))
    assert_true(rational.residue(f, a) == at_pole.coefficients[1])
    assert_true(rational.residue(f, 0).is_zero())
    var wrong = at_pole.copy()
    wrong.valuation = -1
    assert_false(rational.check(wrong))
    var rational_source = rational.asarray([1], [-2, 0, 1])
    var promoted = rational.laurent(rational_source, a, terms=3)
    assert_equal(promoted.valuation, -1)
    assert_true(rational.check(promoted))
    assert_true(promoted.coefficients[0] == algebraic.reciprocal(algebraic.multiply(a, 2)))
    var complex_source = rational.asarray([1], coefficients((algebraic.ascomplex(1), 0, 1)))
    var complex_parts = rational.partial_fractions(complex_source)
    assert_equal(len(complex_parts.terms), 2)
    assert_true(rational.check(complex_parts))
    var i = algebraic.ascomplex(0, 1)
    assert_true(rational.residue(complex_source, i) == algebraic.divide(algebraic.ascomplex(0, -1), 2))
    var series = rational.laurent(complex_source, i, terms=3)
    assert_equal(series.valuation, -1)
    assert_true(rational.check(series))
    var empty = rational.laurent(f, a, terms=0)
    assert_equal(len(empty.coefficients), 0)
    assert_true(rational.check(empty))
    print("array algebraic rational local checks passed")
