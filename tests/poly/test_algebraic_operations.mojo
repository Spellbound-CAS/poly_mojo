"""Checked exact operations and multivariable algebra with irrational coefficients."""
from apn_mojo import Rational
from poly import dense, sparse, algebraic, exact, coefficients, series, basis, roots
from std.testing import assert_equal, assert_true


def main() raises:
    var a = dense.root_between([-2, 0, 1], 1, 2)
    var p = dense.asarray(coefficients((algebraic.negative(a), 1)))
    var squared = dense.multiply(p, p)
    var common = dense.gcd_checked(squared, p)
    assert_true(exact.check(common))
    assert_equal(exact.value(common).to_list(), p.to_list())
    var sq = dense.squarefree_checked(squared)
    assert_true(exact.check(sq))
    var factors = exact.factors(sq)
    assert_equal(len(factors), 1)
    assert_equal(factors[0][1], 2)
    assert_equal(factors[0][0].to_list(), p.to_list())
    var interpolation = dense.interpolate_checked([0, 1], coefficients((a.copy(), algebraic.add(a, 1))))
    assert_true(exact.check(interpolation))
    assert_equal(exact.value(interpolation).to_list(), dense.asarray(coefficients((a.copy(), 1))).to_list())
    assert_true(dense.resultant(p, [-1, 1]) == algebraic.subtract(a, 1))
    var evaluated = dense.evaluate_many(p, coefficients((a.copy(), 0)))
    assert_equal(evaluated.domain(), "AA")
    assert_true(evaluated[0].is_zero())
    assert_true(evaluated[1] == algebraic.negative(a))
    var term = sparse.asarray((((1, 0), 1), ((0, 1), a.copy())))
    var square = sparse.multiply(term, term)
    var sc = sparse.gcd_checked(square, term)
    assert_true(exact.check(sc))
    var sf = sparse.squarefree_checked(square)
    assert_true(exact.check(sf))
    assert_equal(exact.factors(sf)[0][1], 2)
    var specialized = sparse.specialize(term, [(1, a.copy())])
    assert_equal(specialized.domain(), "AA")
    assert_equal(algebraic.coefficients(specialized).domain(), "AA")
    assert_true(algebraic.coefficients(specialized)[0] == algebraic.asreal(2))
    assert_true(sparse.evaluate(specialized, (0, 7)) == algebraic.asreal(2))
    var ordinary = sparse.specialize([((1, 0), 1), ((0, 1), 1)], [(1, a.copy())])
    assert_equal(algebraic.coefficients(ordinary).domain(), "AA")
    assert_equal(sparse.asarray(ordinary).domain(), "AA")
    assert_true(algebraic.check(ordinary))
    var z = algebraic.ascomplex(a, 1)
    var cp = sparse.asarray((((1, 0), 1), ((0, 1), z.copy())))
    var cs = sparse.specialize(cp, [(1, algebraic.conjugate(z))])
    assert_equal(cs.domain(), "QQbar")
    assert_true(sparse.evaluate(cs, (0, 5)) == algebraic.ascomplex(3))
    var generators = (sparse.asarray((((1, 0), 1), ((0, 0), algebraic.negative(a)))), sparse.asarray([((0, 1), 1), ((0, 0), -1)]))
    var gb = sparse.groebner(generators)
    assert_true(sparse.check_groebner(gb))
    assert_equal(len(sparse.reduce(generators[0], gb)), 0)
    var power_series = series.asarray(coefficients((1, a.copy())), order=3)
    assert_equal(power_series.domain(), "AA")
    var chebyshev = basis.asarray(coefficients((a.copy(), 1)), basis="chebyshev")
    assert_equal(chebyshev.domain(), "AA")
    var root_values = dense.real_roots(p)
    assert_equal(len(root_values), 1)
    assert_true(root_values[0] == a)
    assert_true(roots.check(root_values))
    print("array algebraic operation checks passed")
