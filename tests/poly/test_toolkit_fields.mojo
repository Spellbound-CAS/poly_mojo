"""Complex and finite-field operations, empty data, and retained metadata."""
from poly import series, basis, rational, dense, coefficients
from apn_mojo import Rational, ExactComplex
from std.testing import assert_equal, assert_true


def main() raises:
    var ix = series.asarray(coefficients((0, ExactComplex(0, 1))), order=5)
    var e = series.exp(ix)
    assert_equal(e[2], ExactComplex(Rational(-1, 2), 0))
    assert_equal(series.log(e)[1], ExactComplex(0, 1))
    assert_equal(series.derivative(ix)[0], ExactComplex(0, 1))
    assert_equal(series.integral(ix)[2], ExactComplex(0, Rational(1, 2)))
    var x7 = series.asarray(dense.asarray([0, 1], modulus=7), order=5)
    var e7 = series.exp(x7)
    assert_equal(e7[3].value, UInt64(6))
    assert_equal(series.log(e7)[1].value, UInt64(1))
    assert_equal(series.integral(x7)[2].value, UInt64(4))
    var long_x = series.asarray([0, 1], order=32)
    var long_e = series.exp(long_x)
    var back = series.log(long_e)
    assert_equal(back[1], Rational(1))
    assert_equal(back[31], Rational(0))
    assert_equal(len(series.to_polynomial(back)), 2)
    var shape = basis.asarray(coefficients((ExactComplex(0, 1), 1)), basis="chebyshev")
    var ordinary = basis.asarray([1, 1], basis="chebyshev")
    var sum = basis.add(shape, ordinary)
    assert_equal(sum.domain(), "QQi")
    assert_equal(basis.evaluate(sum, 2), ExactComplex(5, 1))
    assert_equal(basis.evaluate(basis.multiply(shape, ordinary), 0), ExactComplex(0, 1))
    var b7 = basis.asarray(dense.asarray([0, 1], modulus=7), basis="bernstein")
    assert_equal(basis.evaluate(basis.multiply(b7, b7), 3).value, UInt64(2))
    assert_equal(basis.evaluate(basis.integral(b7), 1).value, UInt64(4))
    assert_equal(basis.evaluate(basis.from_core(basis.to_core(b7)), 3).value, UInt64(3))
    assert_equal(series.from_core(series.to_core(x7)).modulus(), UInt64(7))
    var zero = rational.asarray([0], [1, -1])
    assert_equal(len(rational.numerator(zero)), 0)
    assert_equal(rational.denominator(zero).to_list(), [(0, Rational(1))])
    var local = rational.laurent(zero, 0, terms=4)
    assert_equal(local.valuation, 0)
    assert_equal(local.coefficients.to_list(), [Rational(0), 0, 0, 0])
    assert_true(rational.check(local))
    assert_equal(len(rational.poles(zero)[1]), 0)
    var second_axis = rational.from_terms([((0, 0), 1)], [((0, 1), 1)])
    assert_equal(rational.residue(second_axis, 0, axis=1), Rational(1))
    var partial = rational.partial_fractions(second_axis, axis=1)
    assert_true(rational.check(partial))
    assert_equal(partial.terms[0][1][1], Rational(1))
    var expansion = rational.laurent(second_axis, 0, terms=2, axis=1)
    assert_true(rational.check(expansion))
    assert_equal(expansion.valuation, -1)
    assert_equal(rational.evaluate(rational.derivative(second_axis, axis=1), (7, 2)), Rational(-1, 4))
    print("array toolkit field checks passed")
