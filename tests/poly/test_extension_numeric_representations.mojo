"""Numerical formal series and alternative bases preserve their metadata."""
from apn_mojo import contains
from std.testing import assert_equal, assert_true
from apn_mojo import Rational, Float, FloatFormat, ArithmeticContext, BallContext, ComplexContext, Complex
from poly import series, basis, dense


def main() raises:
    var ctx = ArithmeticContext(format=FloatFormat(precision=96))
    var a = series.asarray([1, -1], order=6, context=ctx)
    assert_equal(len(a), 6)
    assert_equal(a[5].to_rational_exact(), Rational(0))
    var inverse = series.reciprocal(a, context=ctx)
    for value in inverse:
        assert_equal(value.to_rational_exact(), Rational(1))
    assert_equal(len(series.to_polynomial(series.multiply(a, inverse, context=ctx))), 1)
    assert_equal(series.divide(a, a, context=ctx)[0].to_rational_exact(), Rational(1))
    assert_equal(series.add(a, a, context=ctx)[0].to_rational_exact(), Rational(2))
    assert_equal(series.subtract(a, a, context=ctx)[0].to_rational_exact(), Rational(0))
    assert_equal(series.negative(a, context=ctx)[1].to_rational_exact(), Rational(1))
    var x = series.asarray([0, 1], order=6, context=ctx)
    assert_equal(series.exp(x, context=ctx)[2].to_rational_exact(), Rational(1, 2))
    assert_equal(series.log(series.asarray([1, 1], order=6, context=ctx), context=ctx)[3].to_rational_exact(), Float(Rational(1, 3), context=ctx).to_rational_exact())
    var derivative = series.derivative(a, context=ctx)
    assert_equal(derivative.order(), 5)
    assert_equal(derivative[0].to_rational_exact(), Rational(-1))
    assert_equal(series.integral(derivative, context=ctx).order(), 6)
    var f = series.asarray([0, 1, 1], order=6, context=ctx)
    var reversed = series.revert(f, context=ctx)
    assert_equal(reversed[5].to_rational_exact(), Rational(14))
    assert_equal(series.coefficients(series.compose(f, reversed, context=ctx)).to_list(), series.coefficients(x).to_list())
    assert_equal(series.add(a, series.truncate(a, 3, context=ctx), context=ctx, order=3).order(), 3)
    assert_equal(series.asarray(a, context=ctx).order(), 6)
    var raw = series.to_core(a)
    var restored = series.from_core(raw, context=ctx)
    raw.polynomial.coefficients[0] = Float(9, context=ctx)
    assert_equal(restored[0].to_rational_exact(), Rational(1))
    var cheb = basis.asarray([1, 0, 2, 0], basis="chebyshev", context=ctx)
    assert_equal(len(cheb), 4)
    assert_equal(basis.to_polynomial(cheb, context=ctx)[2].to_rational_exact(), Rational(4))
    assert_equal(basis.evaluate(cheb, 2, context=ctx).to_rational_exact(), Rational(15))
    var newton = basis.asarray([1, 2, 3], basis="newton", nodes=[1, 2], context=ctx)
    assert_equal(basis.evaluate(newton, 3, context=ctx).to_rational_exact(), Rational(11))
    assert_equal(basis.nodes(newton)[1].to_rational_exact(), Rational(2))
    var recovered = basis.from_polynomial([5, -7, 3], basis="newton", nodes=[1, 2], context=ctx)
    assert_equal(basis.coefficients(recovered).to_list(), basis.coefficients(newton).to_list())
    var bern = basis.from_polynomial([0, 0, 1], basis="bernstein", degree=2, context=ctx)
    var halves = basis.subdivide(bern, Rational(1, 2), context=ctx)
    assert_equal(basis.to_polynomial(halves[0], context=ctx)[2].to_rational_exact(), Rational(1, 4))
    assert_equal(basis.to_polynomial(halves[1], context=ctx)[1].to_rational_exact(), Rational(1, 2))
    var x2 = basis.from_polynomial([0, 0, 1], basis="chebyshev", context=ctx)
    assert_equal(basis.to_polynomial(basis.add(x2, x2, context=ctx), context=ctx)[2].to_rational_exact(), Rational(2))
    assert_equal(len(basis.to_polynomial(basis.subtract(x2, x2, context=ctx), context=ctx)), 0)
    assert_equal(basis.to_polynomial(basis.multiply(x2, x2, context=ctx), context=ctx)[4].to_rational_exact(), Rational(1))
    assert_equal(basis.to_polynomial(basis.negative(x2, context=ctx), context=ctx)[2].to_rational_exact(), Rational(-1))
    assert_equal(basis.to_polynomial(basis.derivative(bern, context=ctx), context=ctx)[1].to_rational_exact(), Rational(2))
    assert_equal(basis.to_polynomial(basis.integral(basis.asarray([2], basis="chebyshev", context=ctx), context=ctx), context=ctx)[1].to_rational_exact(), Rational(2))
    var basis_core = basis.to_core(newton)
    var independent = basis.from_core(basis_core, context=ctx)
    basis_core.coefficients[0] = Float(9, context=ctx)
    assert_equal(independent[0].to_rational_exact(), Rational(1))
    var bc = BallContext(precision=96)
    var ball_series = series.exp(series.asarray([0, 1], order=4, context=bc), context=bc)
    assert_true(contains(ball_series[3], Rational(1, 6)))
    var ball_basis = basis.from_polynomial([0, 0, 1], basis="bernstein", degree=3, context=bc)
    assert_true(contains(basis.evaluate(ball_basis, Rational(1, 3), context=bc), Rational(1, 9)))
    var cc = ComplexContext(ctx)
    var complex_series = series.asarray([Complex(0, 0), Complex(0, 1)], order=3, context=cc)
    assert_equal(series.exp(complex_series, context=cc)[2].real().to_rational_exact(), Rational(-1, 2))
    print("array extension numeric_representations checks passed")
