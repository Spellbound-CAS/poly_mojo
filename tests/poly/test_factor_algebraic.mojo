"""Hand-derived real and complex algebraic factorizations."""
from poly import dense, algebraic, coefficients, exact
from std.testing import assert_equal, assert_true


def main() raises:
    var a = dense.root_between([-2, 0, 1], 1, 2)
    var one = algebraic.asreal(1)
    var split = dense.factor(coefficients((-2, 0, one.copy())))
    assert_true(split[0] == one)
    assert_equal(len(split[1]), 2)
    assert_true(split[1][0][0][0] == algebraic.negative(a))
    assert_true(split[1][1][0][0] == a)
    for f in split[1]:
        assert_equal(f[0].domain(), "AA")
        assert_equal(len(f[0]), 2)
        assert_true(f[0][1] == one)
        assert_equal(f[1], 1)
    assert_equal(len(dense.factor([-2, 0, 1])[1]), 1)
    var irreducible = dense.asarray(coefficients((a.copy(), 0, 1)))
    var retained = dense.factor_checked(irreducible)
    assert_true(exact.check(retained))
    assert_equal(len(exact.factors(retained)), 1)
    assert_equal(exact.factors(retained)[0][0].to_list(), irreducible.to_list())
    var linear = dense.asarray(coefficients((algebraic.negative(a), 1)))
    var real_p = dense.multiply(dense.power(linear, 3), dense.power(irreducible, 2))
    real_p = dense.multiply(real_p, [algebraic.negative(a)])
    var real_f = dense.factor_checked(real_p)
    assert_true(exact.check(real_f))
    assert_true(exact.unit(real_f) == algebraic.negative(a))
    var real_factors = exact.factors(real_f)
    assert_equal(len(real_factors), 2)
    assert_equal(real_factors[0][0].to_list(), linear.to_list())
    assert_equal(real_factors[0][1], 3)
    assert_equal(real_factors[1][0].to_list(), irreducible.to_list())
    assert_equal(real_factors[1][1], 2)
    var imaginary = algebraic.ascomplex(0, 1)
    var complex_split = dense.factor_checked(coefficients((algebraic.ascomplex(1), 0, 1)))
    assert_true(exact.check(complex_split))
    var fs = exact.factors(complex_split)
    assert_equal(len(fs), 2)
    assert_true(fs[0][0][0] == algebraic.negative(imaginary))
    assert_true(fs[1][0][0] == imaginary)
    assert_equal(fs[0][0].domain(), "QQbar")
    var z = algebraic.ascomplex(a, 1)
    var w = algebraic.ascomplex(a, -2)
    var scale = algebraic.ascomplex(2, 3)
    var p = dense.multiply(dense.from_roots([z.copy(), z.copy(), w.copy()]), [scale.copy()])
    var f = dense.factor_checked(p)
    assert_true(exact.check(f))
    assert_true(exact.unit(f) == scale)
    fs = exact.factors(f)
    assert_equal(len(fs), 2)
    assert_true(fs[0][0][0] == algebraic.negative(z))
    assert_equal(fs[0][1], 2)
    assert_true(fs[1][0][0] == algebraic.negative(w))
    assert_equal(fs[1][1], 1)
    var origin = dense.factor_checked(coefficients((0, 0, algebraic.asreal(1), 0)))
    assert_true(exact.check(origin))
    var origin_factors = exact.factors(origin)
    assert_equal(len(origin_factors), 1)
    assert_equal(origin_factors[0][1], 2)
    assert_true(origin_factors[0][0][0].is_zero())
    assert_true(origin_factors[0][0][1] == one)
    # Empty and constant arrays preserve their explicitly chosen field.
    assert_equal(len(dense.factor(List[algebraic.Real]())[1]), 0)
    assert_true(dense.factor(List[algebraic.Real]())[0].is_zero())
    assert_equal(len(dense.factor([z.copy()])[1]), 0)
    assert_true(dense.factor([z.copy()])[0] == z)
    assert_true(exact.check(dense.factor_checked([algebraic.ascomplex(0)])))
    assert_true(exact.check(dense.factor_checked([a.copy()])))
    print("array algebraic factorization checks passed")
