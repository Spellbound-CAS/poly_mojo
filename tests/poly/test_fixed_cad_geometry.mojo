"""Hand-checked slices, all-fixed points, and original-axis sample semantics."""
from poly import cad, dense, sparse, algebraic
from apn_mojo import Rational
from polynomials import Budget
from std.testing import assert_true, assert_false, assert_equal


def main() raises:
    var budget = Budget()
    # x - y, restricted to y=2: three cells on the x line.
    var p = [((1, 0), 1), ((0, 1), -1)]
    var result = cad.decompose([p.copy()], fixed=[(1, 2)])
    assert_true(cad.check(result))
    assert_equal(result.evidence().variables(budget), [Int64(1), Int64(0)])
    var cells = cad.cells(result)
    assert_equal(len(cells), 3)
    for i in range(3):
        assert_true(cells[i].sample[1] == algebraic.asreal(2))
        assert_equal(cells[i].signs, [i - 1])
        assert_equal(cells[i].dimension, 0 if i == 1 else 1)
    assert_true(cells[1].sample[0] == algebraic.asreal(2))
    var bindings = cad.fixed_coordinates(result)
    assert_equal(bindings[0][0], 1)
    assert_true(bindings[0][1] == algebraic.asreal(2))
    bindings.clear()
    assert_equal(len(cad.fixed_coordinates(result)), 1)
    var explicit = cad.decompose([p.copy()], fixed=[(1, 2)], axes=[1, 0], lazard=False)
    assert_true(cad.check(explicit))
    assert_equal(len(cad.cells(explicit)), 3)
    var a = dense.root_between([-2, 0, 1], 1, 2)
    var irrational = cad.decompose([p.copy()], fixed=[(1, a.copy())])
    assert_true(cad.check(irrational))
    var icells = cad.cells(irrational)
    assert_equal(len(icells), 3)
    assert_true(icells[1].sample[0] == a and icells[1].sample[1] == a)
    # Heterogeneous binding tuples and arbitrary input order.
    var point = cad.decompose([p.copy()], fixed=((1, a.copy()), (0, 2)))
    assert_true(cad.check(point))
    var pcells = cad.cells(point)
    assert_equal(len(pcells), 1)
    assert_equal(pcells[0].dimension, 0)
    assert_equal(pcells[0].signs, [1])
    assert_equal(cad.fixed_coordinates(point)[0][0], 0)
    var rational = cad.decompose([p.copy()], fixed=[(1, Rational(1, 2))])
    assert_true(cad.check(rational))
    assert_true(cad.cells(rational)[1].sample[0] == algebraic.asreal(Rational(1, 2)))
    # Solving and full covering have the same slice-local meaning.
    var possible = cad.solve([cad.zero(p)], fixed=[(1, 2)])
    assert_true(possible.satisfiable() and cad.check(possible))
    var found = cad.sample(possible)
    var sample = found.take()
    assert_true(sample[0] == algebraic.asreal(2) and sample[1] == algebraic.asreal(2))
    assert_equal(len(cad.fixed_coordinates(possible)), 1)
    var impossible = cad.solve([cad.negative(p)], fixed=[(0, 2), (1, 1)])
    assert_false(impossible.satisfiable())
    assert_false(Bool(cad.sample(impossible)))
    assert_true(cad.check(impossible))
    var full = cad.cover([cad.zero(p)], fixed=[(1, 2)])
    assert_true(full.satisfiable() and cad.check(full))
    var full_sample = cad.sample(full)
    assert_true(full_sample.value()[0] == algebraic.asreal(2))
    assert_equal(len(cad.cells(full)), 3)
    assert_equal(len(cad.fixed_coordinates(full)), 1)
    # A fixed irrational coefficient and a user coordinate coexist.
    var aa = sparse.asarray((((1, 0), 1), ((0, 0), algebraic.negative(a))))
    var combined = cad.decompose([aa.copy()], fixed=[(1, 0)])
    assert_true(cad.check(combined))
    var acells = cad.cells(combined)
    assert_equal(len(acells), 3)
    assert_true(acells[1].sample[0] == a)
    assert_equal(acells[1].signs, [0])
    # No original constraints: synthetic section polynomials still pin the point.
    var empty = List[List[Tuple[Tuple[Int, Int], Int]]]()
    var free = cad.decompose(empty, fixed=[(1, 3)])
    assert_true(cad.check(free))
    assert_equal(len(cad.cells(free)), 1)
    assert_equal(cad.cells(free)[0].dimension, 1)
    assert_equal(len(cad.cells(free)[0].signs), 0)
    var no_fixed = cad.decompose([[(0, -1), (1, 1)]], fixed=())
    assert_true(cad.check(no_fixed))
    assert_equal(len(cad.fixed_coordinates(no_fixed)), 0)
    assert_equal(len(cad.cells(no_fixed)), 3)
    print("fixed CAD geometry checks passed")
