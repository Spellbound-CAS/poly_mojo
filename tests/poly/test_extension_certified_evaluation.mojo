"""Certified enclosures, accuracy outcomes, and evidence corruption."""
from apn_mojo import contains
from std.testing import assert_equal, assert_true, assert_false
from apn_mojo import Rational, ExactComplex, Ball, BallContext, FloatFormat, ArithmeticContext, ComplexContext, Complex
from polynomials import NumericOptions, NumericOutcome, NumericBox, QQ, Budget
from poly import dense, sparse, evaluation


def main() raises:
    var bc = BallContext(precision=80)
    var fixed = dense.enclose([1, 2, 3], Rational(1, 3), context=bc)
    assert_true(evaluation.check(fixed))
    assert_true(contains(fixed.value(), Rational(2)))
    assert_equal(fixed.precision(), 80)
    assert_true(not fixed.outcome())
    assert_false(fixed.accurate())
    var options = NumericOptions(initial_precision=16, max_precision=128, absolute_bits=64)
    var adaptive = dense.adaptive_evaluate([1, 2, 3], Rational(1, 3), options=options)
    assert_true(evaluation.check(adaptive))
    assert_true(adaptive.accurate())
    assert_equal(adaptive.outcome().value(), NumericOutcome.SUCCESS)
    assert_true(contains(adaptive.value(), Rational(2)))
    var wide = dense.adaptive_evaluate([0, 1], Ball(Rational(0), Rational(1), precision=80), options=options)
    assert_true(evaluation.check(wide))
    assert_false(wide.accurate())
    assert_equal(wide.outcome().value(), NumericOutcome.PRECISION_CEILING)
    var complex = dense.enclose([ExactComplex(1, 0), ExactComplex(0, 1)], 2, context=bc)
    assert_true(evaluation.check(complex))
    assert_true(contains(complex.value().real(), Rational(1)))
    assert_true(contains(complex.value().imag(), Rational(2)))
    assert_true(evaluation.check(sparse.enclose([(1, 2)], 3, context=bc)))
    assert_true(evaluation.check(sparse.adaptive_evaluate([(1, 2)], 3, options=options)))
    var univariate = sparse.asarray([(1, 2)], context=bc)
    assert_true(evaluation.check(sparse.enclose(univariate, 3, context=bc)))
    assert_true(evaluation.check(sparse.adaptive_evaluate(univariate, 3, options=options)))
    var p = [((1, 0), 2), ((0, 1), 3)]
    var sp = sparse.enclose(p, (Rational(1, 3), 2), context=bc)
    assert_true(evaluation.check(sp))
    assert_true(contains(sp.value(), Rational(20, 3)))
    var asp = sparse.adaptive_evaluate(p, (Rational(1, 3), 2), options=options)
    assert_true(evaluation.check(asp))
    assert_true(asp.accurate())
    var ctx = ArithmeticContext(format=FloatFormat(precision=96))
    var numeric = dense.asarray([1, 2, 3], context=ctx)
    assert_true(evaluation.check(dense.enclose(numeric, 2, context=bc)))
    var na = dense.adaptive_evaluate(numeric, 2, options=options)
    assert_true(evaluation.check(na))
    assert_true(na.accurate())
    var nsp = sparse.asarray(p, context=ctx)
    assert_true(evaluation.check(sparse.enclose(nsp, (1, 2), context=bc)))
    var nsa = sparse.adaptive_evaluate(nsp, (1, 2), options=options)
    assert_true(evaluation.check(nsa))
    assert_true(contains(nsa.value(), Rational(8)))
    var family = dense.asarray([Ball(Rational(0), Rational(1), precision=80), Ball(1, precision=80)], context=bc)
    var uncertain = dense.adaptive_evaluate(family, 0, options=options)
    assert_true(evaluation.check(uncertain))
    assert_false(uncertain.accurate())
    var bad = dense.enclose([1, 2, 3], 2, context=bc)
    var budget = Budget()
    bad._data[].proof.evaluation.steps[len(bad._data[].proof.evaluation.steps)-1] = NumericBox.point(QQ(Rational(0)), QQ(Rational(0)), budget)
    assert_false(evaluation.check(bad))
    var tampered = dense.adaptive_evaluate([0, 1], Ball(Rational(0), Rational(1), precision=80), options=options)
    tampered._data[].proof.outcome = NumericOutcome.SUCCESS
    assert_false(evaluation.check(tampered))
    print("array extension certified_evaluation checks passed")
