"""Scalar arithmetic follows independent identities and keeps sparse storage."""
from poly import dense, sparse, algebraic, modint
from apn_mojo import Rational, ExactComplex, ArithmeticContext, FloatFormat, Ball, BallContext, ComplexContext, contains
from polynomials import Budget, PolyErrorKind
from std.testing import assert_equal, assert_true


def main() raises:
    var p = dense.asarray([1, 2, 3])
    assert_equal(dense.add(p, 4).to_list(), dense.asarray([5, 2, 3]).to_list())
    assert_equal(dense.add(4, p).to_list(), dense.asarray([5, 2, 3]).to_list())
    assert_equal(dense.subtract(p, 4).to_list(), dense.asarray([-3, 2, 3]).to_list())
    assert_equal(dense.subtract(4, p).to_list(), dense.asarray([3, -2, -3]).to_list())
    assert_equal(dense.multiply(p, 2).to_list(), dense.asarray([2, 4, 6]).to_list())
    assert_equal(dense.multiply(2, p).to_list(), dense.asarray([2, 4, 6]).to_list())
    var half = dense.divide(p, 2)
    assert_equal(half.domain(), "QQ")
    assert_equal(half.to_list(), List[Rational]([Rational(1, 2), Rational(1), Rational(3, 2)]))
    assert_equal(dense.add(p, Rational(1, 2))[0], Rational(3, 2))
    var i = ExactComplex(Rational(0), Rational(1))
    assert_equal(dense.multiply([1, 2], i)[1], ExactComplex(Rational(0), Rational(2)))
    assert_equal(dense.divide([1], i)[0], ExactComplex(Rational(0), Rational(-1)))
    assert_equal(dense.add(List[Int](), modint(2, 7))[0].value, UInt64(2))
    assert_equal(dense.divide([2, 4], modint(2, 7))[1].value, UInt64(2))
    assert_equal(dense.add([modint(1, 7)], 2)[0].value, UInt64(3))
    assert_equal(sparse.multiply([(2, modint(3, 7))], 2)[0][1].value, UInt64(6))
    var root = dense.root_between([-2, 0, 1], 1, 2)
    assert_true(dense.multiply([0, 1], root)[1] == root)
    assert_true(dense.divide([2], root)[0] == root)
    var complex_root = algebraic.ascomplex(root, 1)
    assert_true(dense.add([1], complex_root)[0] == algebraic.add(complex_root, 1))
    var s = sparse.asarray([((2, 0), 3), ((0, 1), 2), ((0, 0), 1)])
    assert_equal(sparse.evaluate(sparse.add(s, 4), (2, 3)), dense.evaluate([11, 0, 3], 2))
    assert_equal(sparse.add(4, s).to_list(), sparse.add(s, 4).to_list())
    assert_equal(sparse.evaluate(sparse.subtract(s, 4), (2, 3)), dense.evaluate([3, 0, 3], 2))
    assert_equal(sparse.evaluate(sparse.subtract(4, s), (2, 3)), dense.evaluate([-3, 0, -3], 2))
    assert_equal(sparse.multiply(s, 2).to_list(), sparse.multiply(2, s).to_list())
    assert_equal(sparse.evaluate(sparse.divide(s, 2), (2, 3)), Rational(19, 2))
    assert_equal(sparse.add(List[Tuple[Int, Int]](), modint(2, 7))[0][1].value, UInt64(2))
    assert_equal(sparse.divide([(2, 4)], modint(2, 7))[0][1].value, UInt64(2))
    assert_true(sparse.divide([(2, 2)], root)[0][1] == root)
    assert_equal(sparse.multiply([(1, 2)], i)[0][1], ExactComplex(Rational(0), Rational(2)))
    assert_true(sparse.multiply([(1, 1)], complex_root)[0][1] == complex_root)
    var fc = ArithmeticContext(format=FloatFormat(precision=61))
    var n = dense.asarray([1, 2], context=fc)
    assert_equal(dense.add(n, 3, context=fc)[0].to_rational_exact(), Rational(4))
    assert_equal(dense.add(3, n, context=fc)[0].to_rational_exact(), Rational(4))
    assert_equal(dense.subtract(n, 3, context=fc)[0].to_rational_exact(), Rational(-2))
    assert_equal(dense.subtract(3, n, context=fc)[1].to_rational_exact(), Rational(-2))
    assert_equal(dense.multiply(n, 2, context=fc)[1].to_rational_exact(), Rational(4))
    assert_equal(dense.multiply(2, n, context=fc)[1].to_rational_exact(), Rational(4))
    assert_equal(dense.divide(n, 2, context=fc)[0].to_rational_exact(), Rational(1, 2))
    var ns = sparse.asarray([((1000000000, 0), 6), ((0, 1), 2)], context=fc)
    var scaled = sparse.divide(ns, 2, context=fc, max_steps=1000000)
    assert_equal(len(scaled), 2)
    assert_equal(scaled[1][0], (1000000000, 0))
    assert_equal(scaled[1][1].to_rational_exact(), Rational(3))
    assert_equal(sparse.add(ns, 3, context=fc)[0][1].to_rational_exact(), Rational(3))
    assert_equal(sparse.add(3, ns, context=fc)[0][1].to_rational_exact(), Rational(3))
    assert_equal(sparse.subtract(ns, 3, context=fc)[0][1].to_rational_exact(), Rational(-3))
    assert_equal(sparse.subtract(3, ns, context=fc)[2][1].to_rational_exact(), Rational(-6))
    assert_equal(sparse.multiply(ns, 2, context=fc)[1][1].to_rational_exact(), Rational(12))
    assert_equal(sparse.multiply(2, ns, context=fc)[1][1].to_rational_exact(), Rational(12))
    var bc = BallContext(precision=71)
    var balls = sparse.asarray([(4, 3)], context=bc)
    var ball_scaled = sparse.divide(balls, Ball(Rational(2), Rational(1, 8), precision=71), context=bc)
    assert_true(contains(ball_scaled[0][1], Rational(3, 2)))
    var cc = ComplexContext(real=fc, imag=fc)
    var complex_n = dense.asarray([1, 2], context=cc)
    assert_equal(dense.multiply(complex_n, i, context=cc)[1].imag().to_rational_exact(), Rational(2))
    var cb = sparse.asarray([(2, i.copy())], context=bc)
    assert_true(contains(sparse.divide(cb, 2, context=bc)[0][1].imag(), Rational(1, 2)))
    var uncertain_zero = Ball(Rational(0), Rational(1), precision=71)
    for mode in range(7):
        var rejected = False
        try:
            if mode == 0: _ = dense.divide(List[Int](), 0)
            elif mode == 1: _ = sparse.divide(List[Tuple[Int, Int]](), 0)
            elif mode == 2: _ = dense.add([modint(1, 7)], modint(1, 11))
            elif mode == 3: _ = sparse.multiply([(0, modint(1, 7))], modint(1, 11))
            elif mode == 4: _ = sparse.divide(balls, uncertain_zero, context=bc)
            elif mode == 5: _ = dense.divide(n, 0, context=fc)
            else: _ = dense.add(n, i, context=fc)
        except e: rejected = e.kind == PolyErrorKind.DOMAIN
        assert_true(rejected)
    var meter = Budget()
    _ = sparse.divide(ns, 2, meter, context=fc)
    var used = UInt64.MAX - meter.remaining()
    var exact = Budget(used)
    _ = sparse.divide(ns, 2, exact, context=fc)
    assert_equal(exact.remaining(), UInt64(0))
    var short = Budget(used - 1)
    var limited = False
    try: _ = sparse.divide(ns, 2, short, context=fc)
    except e: limited = e.kind == PolyErrorKind.LIMIT
    assert_true(limited)
    assert_equal(p.to_list(), dense.asarray([1, 2, 3]).to_list())
    assert_equal(ns[1][1].to_rational_exact(), Rational(6))
    print("surface scalar arithmetic checks passed")
