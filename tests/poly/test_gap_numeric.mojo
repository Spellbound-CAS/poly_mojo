"""Rounded and enclosing polynomial arrays use explicit precision."""
from std.testing import assert_equal, assert_true
from apn_mojo import Float, Ball, Complex, ComplexBall, FloatFormat, ArithmeticContext, ComplexContext, BallContext, Rational
from poly import dense, sparse, to_dense, to_sparse, roots
from polynomials import Budget, BallDomain, numeric_bounds, NumericOptions


def main() raises:
    var ctx = ArithmeticContext(format=FloatFormat(precision=80))
    var p = dense.asarray([1, 2, 3], context=ctx)
    assert_equal(dense.evaluate(p, 2, context=ctx).to_rational_exact(), Rational(17))
    var square = dense.multiply(p, p, context=ctx)
    assert_equal(square[2].to_rational_exact(), Rational(10))
    assert_equal(dense.derivative(p, context=ctx)[0].to_rational_exact(), Rational(2))
    assert_equal(dense.integral(p, context=ctx)[3].to_rational_exact(), Rational(1))
    var native = dense.asarray([Float64(0.5), Float64(2)], context=ctx)
    assert_equal(dense.evaluate(native, 2, context=ctx).to_rational_exact(), Rational(9, 2))
    var bc = BallContext(precision=80)
    var balls = dense.asarray([Rational(1, 3), Rational(2)], context=bc)
    assert_equal(len(balls), 2)
    var result = dense.evaluate(balls, 1, context=bc)
    assert_true(result.is_finite())
    var uncertain = dense.asarray([Ball(1, precision=80), Ball(Rational(0), Rational(1), precision=80)], context=bc)
    assert_equal(len(uncertain), 2)
    var sp = sparse.asarray([((1, 0), 2), ((0, 1), 3)], context=ctx)
    assert_equal(sparse.derivative(sp, context=ctx, axis=1)[0][1].to_rational_exact(), Rational(3))
    assert_equal(len(sparse.multiply(sp, sp, context=ctx)), 3)
    assert_equal(sparse.evaluate(sp, (2, 1), context=ctx).to_rational_exact(), Rational(7))
    assert_equal(dense.degree_bound(uncertain), 1)
    assert_true(not dense.certified_degree(uncertain))
    var bounds_budget = Budget()
    var box = numeric_bounds[BallDomain](result, bounds_budget)
    assert_true(box.real_low.value <= Rational(7, 3) and box.real_high.value >= Rational(7, 3))
    var copy = dense.to_core(p)
    copy.coefficients[0] = Float(9, context=ctx)
    assert_equal(p[0].to_rational_exact(), Rational(1))
    assert_equal(dense.from_core(copy)[0].to_rational_exact(), Rational(9))
    var roundtrip = to_dense(to_sparse(p, context=ctx), context=ctx)
    assert_equal(roundtrip.to_list(), p.to_list())
    var cc = ComplexContext(ctx)
    var complex = dense.asarray((1, Complex(0, 1)), context=cc)
    assert_equal(dense.evaluate(complex, Complex(0, 1), context=cc).real().to_rational_exact(), Rational(0))
    var cb = dense.asarray((1, ComplexBall(0, 1)), context=bc)
    assert_equal(len(cb), 2)
    var linear = dense.asarray([-1, 1], context=ctx)
    var options = NumericOptions(absolute_bits=2, max_subdivisions=256)
    var cover = dense.real_root_cover(linear, options=options, complete_only=True)
    assert_true(roots.check(cover))
    assert_equal(len(roots.intervals(cover)), 1)
    assert_true(roots.check(roots.refine(cover, NumericOptions(absolute_bits=3, max_subdivisions=256), complete_only=True)))
    var sparse_core = sparse.to_core(sp)
    var sparse_roundtrip = sparse.from_core[ndim=2](sparse_core)
    assert_equal(sparse.evaluate(sparse_roundtrip, (2, 1), context=ctx).to_rational_exact(), Rational(7))
    var complex_cover = dense.complex_root_cover(linear, options=options, complete_only=True)
    assert_true(roots.check(complex_cover))
    assert_equal(len(roots.rectangles(complex_cover)), 1)
    assert_true(roots.check(roots.refine(complex_cover, NumericOptions(absolute_bits=3, max_subdivisions=256), complete_only=True)))
    print("array gap numeric checks passed")
