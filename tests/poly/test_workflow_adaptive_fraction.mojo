"""Adaptive fraction evaluation certifies the quotient and preserves input uncertainty."""
from poly import rational, dense, algebraic, coefficients, io
from apn_mojo import Ball, Rational, BallContext, ExactComplex, ArithmeticContext, FloatFormat
from polynomials import Budget, PolyError, PolyErrorKind, NumericOptions, NumericOutcome, numeric_bounds, BallDomain, ComplexBallDomain
from std.testing import assert_true, assert_false, assert_equal

def main() raises:
    var options = NumericOptions(initial_precision=8, max_precision=64, absolute_bits=30)
    var f = rational.asarray([1], [3, 1])
    var result = rational.adaptive_evaluate(f, 0, options=options)
    assert_true(result.accurate())
    assert_true(result.has_value())
    assert_true(result.precision() > 8)
    assert_true(rational.check(result))
    var work = Budget()
    var box = numeric_bounds[BallDomain](result.value(), work)
    assert_true(box.real_low.value <= Rational(1, 3))
    assert_true(box.real_high.value >= Rational(1, 3))
    var saved = io.loads[type_of(result)](io.dumps(result))
    assert_true(rational.check(saved))
    saved._outcome = NumericOutcome.PRECISION_CEILING
    assert_false(rational.check(saved))
    var wrong_precision = result.copy()
    wrong_precision._precision = 8
    assert_false(rational.check(wrong_precision))
    var wrong_point = rational.adaptive_evaluate(f, 1, options=options)
    var wrong = result.copy()
    wrong._denominator = wrong_point._denominator.copy()
    assert_false(rational.check(wrong))
    var coarse = NumericOptions(initial_precision=8, max_precision=8, absolute_bits=40)
    var unfinished = rational.adaptive_evaluate(f, (0,), options=coarse)
    assert_false(unfinished.accurate())
    assert_true(unfinished.has_value())
    assert_equal(unfinished.outcome(), NumericOutcome.PRECISION_CEILING)
    assert_true(rational.check(unfinished))
    var pole = rational.adaptive_evaluate(f, -3, options=coarse)
    assert_false(pole.has_value())
    assert_true(rational.check(pole))
    assert_true(rational.check(io.loads[type_of(pole)](io.dumps(pole))))
    var rejected = False
    try:
        _ = pole.value()
    except error:
        rejected = error.kind == PolyErrorKind.DOMAIN
    assert_true(rejected)
    var a = dense.root_between([-2, 0, 1], 1, 2)
    var af = rational.asarray(coefficients((1,)), coefficients((algebraic.negative(a), 1)))
    var point = algebraic.add(a, Rational(1, 1024))
    var refined = rational.adaptive_evaluate(af, point, options=NumericOptions(initial_precision=8, max_precision=64, absolute_bits=12))
    assert_true(refined.accurate())
    assert_true(refined.precision() > 8)
    assert_true(rational.check(refined))
    var ab = numeric_bounds[BallDomain](refined.value(), work)
    assert_true(ab.real_low.value <= Rational(1024) and ab.real_high.value >= Rational(1024))
    var numerical = rational.asarray(f, context=BallContext(precision=80))
    assert_true(rational.check(rational.adaptive_evaluate(numerical, 0, options=options)))
    assert_true(rational.check(rational.adaptive_evaluate(numerical, (0,), options=options)))
    var floats = rational.asarray(f, context=ArithmeticContext(format=FloatFormat(precision=80)))
    assert_true(rational.check(rational.adaptive_evaluate(floats, 0, options=options)))
    var complex_f = rational.asarray([ExactComplex(Rational(0), Rational(1))], [ExactComplex(Rational(3))])
    var complex_result = rational.adaptive_evaluate(complex_f, 0, options=options)
    assert_true(rational.check(complex_result))
    var complex_numeric = rational.asarray(complex_f, context=BallContext(precision=80))
    assert_true(rational.check(rational.adaptive_evaluate(complex_numeric, (0,), options=options)))
    var cp = numeric_bounds[ComplexBallDomain](complex_result.value(), work)
    assert_true(cp.imag_low.value <= Rational(1, 3) and cp.imag_high.value >= Rational(1, 3))
    var uncertain = Ball(Rational(0), Rational(1), precision=80)
    var uncertain_result = rational.adaptive_evaluate(rational.asarray([1], [0, 1]), uncertain, options=options)
    assert_false(uncertain_result.has_value())
    assert_false(uncertain_result.accurate())
    assert_true(rational.check(uncertain_result))
    var family = rational.asarray([Ball(Rational(1), Rational(1, 8), precision=80)], [Ball(1, precision=80)], context=BallContext(precision=80))
    var family_result = rational.adaptive_evaluate(family, 0, options=options)
    assert_true(family_result.has_value())
    assert_false(family_result.accurate())
    assert_true(rational.check(family_result))
    var family_box = numeric_bounds[BallDomain](family_result.value(), work)
    assert_true(family_box.real_low.value <= Rational(7, 8) and family_box.real_high.value >= Rational(9, 8))
    var relative = rational.adaptive_evaluate(f, 0, options=NumericOptions(initial_precision=8, max_precision=64, absolute_bits=0, relative_bits=30))
    assert_true(relative.accurate())
    assert_true(rational.check(relative))
    var zero_result = rational.adaptive_evaluate(rational.asarray([0]), 0, options=options)
    assert_true(zero_result.accurate())
    assert_true(rational.check(zero_result))
    var multivariate = rational.from_terms([((0, 0), 1)], [((1, 0), 1), ((0, 1), 1)])
    var multi = rational.adaptive_evaluate(multivariate, (1, 2), options=options)
    assert_true(multi.accurate())
    assert_true(rational.check(multi))
    var multi_bounds = numeric_bounds[BallDomain](multi.value(), work)
    assert_true(multi_bounds.real_low.value <= Rational(1, 3) and multi_bounds.real_high.value >= Rational(1, 3))
    var multi_numeric = rational.asarray(multivariate, context=BallContext(precision=80))
    assert_true(rational.check(rational.adaptive_evaluate(multi_numeric, (1, 2), options=options)))
    var usage = Budget()
    _ = rational.adaptive_evaluate(f, 0, usage, options=options)
    var spent = UInt64.MAX - usage.remaining()
    var exact = Budget(spent)
    _ = rational.adaptive_evaluate(f, 0, exact, options=options)
    assert_equal(exact.remaining(), UInt64(0))
    rejected = False
    try:
        _ = rational.adaptive_evaluate(f, 0, options=options, max_steps=spent - 1)
    except error:
        rejected = error.kind == PolyErrorKind.LIMIT
    assert_true(rejected)
    print("workflow adaptive fraction checks passed")
