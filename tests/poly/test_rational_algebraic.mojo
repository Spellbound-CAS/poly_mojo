"""Exact field inference, arithmetic, calculus, substitution, and core exchange."""
from poly import rational, dense, sparse, algebraic, coefficients
from apn_mojo import ExactComplex
from std.testing import assert_true, assert_equal


def main() raises:
    var a = dense.root_between([-2, 0, 1], 1, 2)
    var one = algebraic.asreal(1)
    var f = rational.asarray(coefficients((algebraic.negative(a), 0, a.copy())), [-1, 1])
    assert_equal(f.domain(), "AA")
    assert_true(rational.check(f))
    assert_true(rational.evaluate(f, 1) == algebraic.multiply(a, 2))
    assert_equal(rational.numerator(f).to_list(), [(0, a.copy()), (1, a.copy())])
    var q = rational.asarray([1], [0, 1])
    assert_true(rational.evaluate(rational.add(f, q), 1) == algebraic.add(algebraic.multiply(a, 2), 1))
    assert_true(rational.evaluate(rational.subtract(f, q), 1) == algebraic.subtract(algebraic.multiply(a, 2), 1))
    assert_true(rational.evaluate(rational.multiply(f, q), 2) == algebraic.divide(algebraic.multiply(a, 3), 2))
    assert_true(rational.evaluate(rational.divide(f, q), 2) == algebraic.multiply(a, 6))
    assert_true(rational.evaluate(rational.negative(f), 0) == algebraic.negative(a))
    assert_true(rational.evaluate(rational.reciprocal(f), 0) == algebraic.reciprocal(a))
    assert_true(rational.evaluate(rational.derivative(f), 7) == a)
    assert_true(rational.evaluate(rational.compose(f, q), 2) == algebraic.divide(algebraic.multiply(a, 3), 2))
    assert_true(rational.evaluate(q, a) == algebraic.reciprocal(a))
    var i = algebraic.ascomplex(0, 1)
    var z = algebraic.ascomplex(a, 1)
    var cf = rational.asarray([z.copy()], [1, 1])
    assert_equal(cf.domain(), "QQbar")
    assert_true(rational.check(cf))
    assert_true(rational.evaluate(cf, i) == algebraic.divide(z, algebraic.add(i, 1)))
    assert_equal(rational.add(f, cf).domain(), "QQbar")
    var gaussian = rational.asarray([ExactComplex(0, 1)], [1])
    assert_equal(gaussian.domain(), "QQi")
    assert_equal(rational.add(f, gaussian).domain(), "QQbar")
    assert_true(rational.evaluate(gaussian, 0) == ExactComplex(0, 1))
    var mv = rational.from_terms([((1, 0), a.copy()), ((0, 1), one.copy())], [((0, 0), 1)])
    assert_true(rational.evaluate(mv, (1, a.copy())) == algebraic.multiply(a, 2))
    var x = sparse.asarray([((1, 0), one.copy())])
    var y = sparse.asarray([((0, 1), one.copy())])
    var swapped = rational.substitute(mv, [y.copy(), x.copy()])
    assert_true(rational.evaluate(swapped, (2, 1)) == algebraic.add(a, 2))
    var promoted = rational.substitute(rational.from_terms([(1, 1)], [(0, 1)]), [sparse.asarray([(0, a.copy())])])
    assert_true(rational.evaluate(promoted, 5) == a)
    var exported = rational.to_core(cf)
    var restored = rational.from_core[ndim=1](exported)
    assert_true(rational.check(restored))
    exported[0].terms[0].coefficient = algebraic.ascomplex(0)
    assert_true(rational.evaluate(restored, 0) == z)
    var zero = rational.from_terms([((), a.copy())], [((), 1)])
    assert_equal(zero.ndim(), 0)
    assert_true(rational.evaluate(zero, ()) == a)
    assert_true(rational.check(rational.from_core[ndim=0](rational.to_core(zero))))
    print("array algebraic rational checks passed")
